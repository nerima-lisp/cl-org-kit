; Generated from org-clock-in and org-clock-out with Emacs 31.1 and Org 9.8.10.
; Case timestamps are explicit; TZ and locale are bound per oracle call.
((:id "default-logbook" :org-drawer-name "LOGBOOK" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line nil)
 (:id "clock-setting" :org-drawer-name "GLOBAL" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line nil)
 (:id "local-property-overrides-setting" :org-drawer-name "LOCAL" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line nil)
 (:id "inherited-property-overrides-setting" :org-drawer-name "INHERITED" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line nil)
 (:id "clock-property-true-uses-log-setting" :org-drawer-name "LOGS" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line nil)
 (:id "closed-line-format" :org-drawer-name "LOGBOOK" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in nil :org-closed-line "CLOCK: [2026-10-14 Wed 09:05]--[2026-10-14 Wed 10:37] =>  1:32")
 (:id "insertion-after-metadata-before-body" :org-drawer-name "LOGBOOK" :org-open-line "CLOCK: [2026-10-14 Wed 09:05]" :org-source-after-in "* Default drawer
* Setting name
* Local property
:PROPERTIES:
:CLOCK_INTO_DRAWER: LOCAL
:END:
* Inherited property
:PROPERTIES:
:CLOCK_INTO_DRAWER: INHERITED
:END:
** Child
* Log setting fallback
:PROPERTIES:
:CLOCK_INTO_DRAWER: t
:END:
* Closed interval
* Insertion placement
SCHEDULED: <2026-10-20 Tue>
:PROPERTIES:
:OWNER: Example
:END:
:LOGBOOK:
CLOCK: [2026-10-14 Wed 09:05]
:END:
Body text remains outside the new drawer.
" :org-closed-line nil))
