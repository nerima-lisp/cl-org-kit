; Generated from org-clock-get-table-data with Emacs 31.1 and Org 9.8.10.
; Each case narrows to its selected heading subtree.
; Time zones are bound per case; open clocks are excluded.
; Rows use reduced levels, effective tags, and matched subtree minutes.
; Inline-task minimum level is case-bound (default 15).
(
(:id "project-full-day" :org-clock-total-minutes 150 :org-clock-rows ((:level 1 :title "Project" :tags ("project") :minutes 150) (:level 2 :title "Alpha" :tags ("project" "focus") :minutes 60) (:level 3 :title "Focus leaf" :tags ("project" "focus" "leaf") :minutes 30) (:level 2 :title "Beta" :tags ("project" "ops") :minutes 30)))
 (:id "project-match-focus" :org-clock-total-minutes 60 :org-clock-rows ((:level 1 :title "Project" :tags ("project") :minutes 60) (:level 2 :title "Alpha" :tags ("project" "focus") :minutes 60) (:level 3 :title "Focus leaf" :tags ("project" "focus" "leaf") :minutes 30)))
 (:id "project-max-depth-one" :org-clock-total-minutes 150 :org-clock-rows ((:level 1 :title "Project" :tags ("project") :minutes 150)))
 (:id "project-max-depth-zero" :org-clock-total-minutes 150 :org-clock-rows nil)
 (:id "alpha-subtree" :org-clock-total-minutes 60 :org-clock-rows ((:level 2 :title "Alpha" :tags ("project" "focus") :minutes 60) (:level 3 :title "Focus leaf" :tags ("project" "focus" "leaf") :minutes 30)))
 (:id "project-partial-range" :org-clock-total-minutes 75 :org-clock-rows ((:level 1 :title "Project" :tags ("project") :minutes 75) (:level 2 :title "Alpha" :tags ("project" "focus") :minutes 45) (:level 3 :title "Focus leaf" :tags ("project" "focus" "leaf") :minutes 30)))
 (:id "project-empty-range" :org-clock-total-minutes 0 :org-clock-rows nil)
 (:id "project-no-match" :org-clock-total-minutes 0 :org-clock-rows nil)
 (:id "project-default-depth-30" :org-clock-total-minutes 1 :org-clock-rows ((:level 1 :title "Deep root" :tags nil :minutes 1) (:level 2 :title "Deep 01" :tags nil :minutes 1) (:level 3 :title "Deep 02" :tags nil :minutes 1) (:level 4 :title "Deep 03" :tags nil :minutes 1) (:level 5 :title "Deep 04" :tags nil :minutes 1) (:level 6 :title "Deep 05" :tags nil :minutes 1) (:level 7 :title "Deep 06" :tags nil :minutes 1) (:level 8 :title "Deep 07" :tags nil :minutes 1) (:level 9 :title "Deep 08" :tags nil :minutes 1) (:level 10 :title "Deep 09" :tags nil :minutes 1) (:level 11 :title "Deep 10" :tags nil :minutes 1) (:level 12 :title "Deep 11" :tags nil :minutes 1) (:level 13 :title "Deep 12" :tags nil :minutes 1) (:level 14 :title "Deep 13" :tags nil :minutes 1) (:level 15 :title "Deep 14" :tags nil :minutes 1) (:level 16 :title "Deep 15" :tags nil :minutes 1) (:level 17 :title "Deep 16" :tags nil :minutes 1) (:level 18 :title "Deep 17" :tags nil :minutes 1) (:level 19 :title "Deep 18" :tags nil :minutes 1) (:level 20 :title "Deep 19" :tags nil :minutes 1) (:level 21 :title "Deep 20" :tags nil :minutes 1) (:level 22 :title "Deep 21" :tags nil :minutes 1) (:level 23 :title "Deep 22" :tags nil :minutes 1) (:level 24 :title "Deep 23" :tags nil :minutes 1) (:level 25 :title "Deep 24" :tags nil :minutes 1) (:level 26 :title "Deep 25" :tags nil :minutes 1) (:level 27 :title "Deep 26" :tags nil :minutes 1) (:level 28 :title "Deep 27" :tags nil :minutes 1) (:level 29 :title "Deep 28" :tags nil :minutes 1) (:level 30 :title "Deep 29" :tags nil :minutes 1)))
 (:id "unscoped-duration-partial-range" :org-clock-total-minutes 15 :org-clock-rows ((:level 1 :title "Unscoped duration" :tags nil :minutes 15))))
