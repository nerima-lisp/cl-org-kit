(:cases
 ((:id "project-full-day"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC")
  (:id "project-match-focus"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC"
   :match "+focus")
  (:id "project-max-depth-one"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC"
   :max-depth 1)
  (:id "project-max-depth-zero"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC"
   :max-depth 0)
  (:id "alpha-subtree"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project" "Alpha")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC")
  (:id "project-partial-range"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12T09:30:00"
   :to "2026-10-12T10:30:00"
   :zone "UTC")
  (:id "project-empty-range"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12T10:00:00"
   :to "2026-10-12T10:00:00"
   :zone "UTC")
  (:id "project-no-match"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Project")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC"
   :match "+missing")
  (:id "project-default-depth-30"
   :action :clocktable-data
   :source "g2-clocktable-depth.org"
   :heading-path ("Deep root")
   :from "2026-10-12"
   :to "2026-10-13"
   :zone "UTC"
   :inlinetask-min-level 99)
  (:id "unscoped-duration-partial-range"
   :action :clocktable-data
   :source "g2-clocktable.org"
   :heading-path ("Unscoped duration")
   :from "2026-10-12T09:30:00"
   :to "2026-10-12T10:30:00"
   :zone "UTC")))
