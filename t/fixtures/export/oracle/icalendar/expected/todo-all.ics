BEGIN:VCALENDAR
VERSION:2.0
X-WR-CALNAME:todo-all
PRODID:-//Oracle Fixture//Emacs with Org mode//EN
X-WR-TIMEZONE:UTC
X-WR-CALDESC:All TODO states
CALSCALE:GREGORIAN
BEGIN:VTODO
UID:TODO-all-open
DTSTAMP:20000101T000000Z
SUMMARY:Open task
CATEGORIES:todo-all
SEQUENCE:1
PRIORITY:5
STATUS:NEEDS-ACTION
END:VTODO
BEGIN:VTODO
UID:TODO-all-done
DTSTAMP:20000101T000000Z
SUMMARY:Finished task
CATEGORIES:todo-all
SEQUENCE:1
PRIORITY:5
STATUS:COMPLETED
END:VTODO
END:VCALENDAR
